<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:FiszkiApp.ViewModel"
             xmlns:vm="clr-namespace:FiszkiApp.ViewModel"
             x:Class="FiszkiApp.View.FlashCardList"
             x:Name="List">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <Image Source="background.png" Aspect="AspectFill" Opacity="0.2" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" Grid.RowSpan="3"/>

        <VerticalStackLayout Grid.Row="0" Padding="10" Spacing="10">
            <StackLayout Orientation="Horizontal" Spacing="5" VerticalOptions="Center">
                <Frame BackgroundColor="#22512BD4" Padding="0" HorizontalOptions="FillAndExpand" CornerRadius="30">
                    <Entry Placeholder="Szukaj kategorii" MaxLength="50" x:Name="CategorySearchEntry" Text="{Binding CategorySearch}" 
                       PlaceholderColor="DarkViolet" TextColor="Black" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="FillAndExpand"/>
                </Frame>
                <ImageButton Source="trash_red.png" WidthRequest="30" HeightRequest="30" BackgroundColor="Transparent" CornerRadius="15" Command="{Binding ClearCategorySearchCommand}" />
            </StackLayout>

            <StackLayout Orientation="Horizontal" Spacing="5" VerticalOptions="Center">
                <Frame BackgroundColor="#22512BD4" Padding="0" HorizontalOptions="FillAndExpand" CornerRadius="30">
                    <Picker x:Name="LanguageLevelPicker" Title="Poziom językowy" TitleColor="DarkViolet" ItemsSource="{Binding LanguageLevels}" SelectedItem="{Binding SelectedLanguageLevel}" 
                        TextColor="Black" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="FillAndExpand"/>
                </Frame>
                <ImageButton Source="trash_red.png" WidthRequest="30" HeightRequest="30" BackgroundColor="Transparent" CornerRadius="15" Command="{Binding ClearSelectedLanguageLevelCommand}" />
            </StackLayout>

            <StackLayout Orientation="Horizontal" Spacing="5" VerticalOptions="Center">
                <Frame BackgroundColor="#22512BD4" Padding="0" HorizontalOptions="FillAndExpand" CornerRadius="30">
                    <Entry Placeholder="Fiszki użytkownika" MaxLength="50" x:Name="UserSearchEntry" Text="{Binding UserSearch}" 
                       PlaceholderColor="DarkViolet" TextColor="Black" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="FillAndExpand"/>
                </Frame>
                <ImageButton Source="trash_red.png" WidthRequest="30" HeightRequest="30" BackgroundColor="Transparent" CornerRadius="15" Command="{Binding ClearUserSearchCommand}" />
            </StackLayout>

            <StackLayout Orientation="Horizontal" Spacing="5" VerticalOptions="Center">
                <Frame BackgroundColor="#22512BD4" Padding="0" HorizontalOptions="FillAndExpand" CornerRadius="30">
                    <Picker x:Name="LanguagePicker" Title="Język" TitleColor="DarkViolet" ItemsSource="{Binding UserLanguages}" SelectedItem="{Binding SelectedLanguage}" 
                        TextColor="Black" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="FillAndExpand"/>
                </Frame>
                <ImageButton Source="trash_red.png" WidthRequest="30" HeightRequest="30" BackgroundColor="Transparent" CornerRadius="15" Command="{Binding ClearSelectedLanguageCommand}" />
            </StackLayout>

            <Button Text="Wyszukaj" Command="{Binding SearchCommand}" CornerRadius="30" WidthRequest="200" />
        </VerticalStackLayout>

        <ListView Grid.Row="1"
                  ItemsSource="{Binding SearchResults}"
                  x:Name="ResultsListView"
                  Margin="10"
                  HasUnevenRows="True">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Grid Padding="10" VerticalOptions="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Path=BindingContext.LookFlashCardTappedCommand, Source={x:Reference Name=List}}"
                                              CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>

                            <Label Text="{Binding CategoryName}" TextColor="DarkViolet" Grid.Column="0" VerticalOptions="Center" HorizontalOptions="Start" FontSize="Medium" />

                            <Label Text="{Binding LanguageLevel}" TextColor="DarkViolet" Grid.Column="1" VerticalOptions="Center" HorizontalOptions="Center" FontSize="Small" Margin="0,0,10,0"/>

                            <Label Text="{Binding FrontLanguage}" TextColor="DarkViolet" Grid.Column="2" VerticalOptions="Center" HorizontalOptions="Center" FontSize="Small" Margin="0,0,10,0" />

                            <Label Text="{Binding BackLanguage}" TextColor="DarkViolet" Grid.Column="3" VerticalOptions="Center" HorizontalOptions="Center" FontSize="Small" Margin="0,0,10,0" />

                            <ImageButton Source="add.png" Grid.Column="4" WidthRequest="35" HeightRequest="35" Margin="3" BackgroundColor="Transparent" Command="{Binding Source={RelativeSource AncestorType={x:Type local:FlashCardListViewModel}}, Path=AddToLocalCommand}" 
                                         CommandParameter="{Binding .}" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Grid>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="2" VerticalOptions="End">
            <BoxView Color="Red" HeightRequest="5" />
        </Grid>
    </Grid>
</ContentPage>