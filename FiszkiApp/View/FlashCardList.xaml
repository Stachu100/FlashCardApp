<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:FiszkiApp.ViewModel"
             xmlns:vm="clr-namespace:FiszkiApp.ViewModel"
             x:Class="FiszkiApp.View.FlashCardList"
             Title="Lista wyszukiwania"
             x:Name="List">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Image Source="{DynamicResource BackgroundImage}" Aspect="AspectFill" Opacity="0.2" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" Grid.RowSpan="3" />

        <VerticalStackLayout Grid.Row="0" Padding="10" Spacing="10">
            <StackLayout Orientation="Horizontal" Spacing="5" VerticalOptions="Center">
                <Frame Padding="0" HorizontalOptions="FillAndExpand" CornerRadius="30">
                    <Entry Placeholder="Szukaj kategorii" MaxLength="50" x:Name="CategorySearchEntry" Text="{Binding CategorySearch}" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="FillAndExpand" />
                </Frame>
                <ImageButton Source="trash_red.png" WidthRequest="30" HeightRequest="30" CornerRadius="15" Command="{Binding ClearCategorySearchCommand}" />
            </StackLayout>

            <StackLayout Orientation="Horizontal" Spacing="5" VerticalOptions="Center">
                <Frame Padding="0" HorizontalOptions="FillAndExpand" CornerRadius="30">
                    <Picker x:Name="LanguageLevelPicker" Title="Poziom językowy" ItemsSource="{Binding LanguageLevels}" SelectedItem="{Binding SelectedLanguageLevel}" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="FillAndExpand" />
                </Frame>
                <ImageButton Source="trash_red.png" WidthRequest="30" HeightRequest="30" CornerRadius="15" Command="{Binding ClearSelectedLanguageLevelCommand}" />
            </StackLayout>

            <StackLayout Orientation="Horizontal" Spacing="5" VerticalOptions="Center">
                <Frame Padding="0" HorizontalOptions="FillAndExpand" CornerRadius="30">
                    <Entry Placeholder="Fiszki użytkownika" MaxLength="50" x:Name="UserSearchEntry" Text="{Binding UserSearch}" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="FillAndExpand" />
                </Frame>
                <ImageButton Source="trash_red.png" WidthRequest="30" HeightRequest="30" CornerRadius="15" Command="{Binding ClearUserSearchCommand}" />
            </StackLayout>

            <Label Text="Najpierw wybierz języki fiszek w profilu" TextColor="Red" IsVisible="{Binding LanguagePickerTitle}" FontAttributes="Bold" />
            <StackLayout Orientation="Horizontal" Spacing="5" VerticalOptions="Center">
                <Frame Padding="0" HorizontalOptions="FillAndExpand" CornerRadius="30">
                    <Picker x:Name="LanguagePicker" Title="Język" ItemsSource="{Binding UserLanguages}" SelectedItem="{Binding SelectedLanguage}" IsEnabled="{Binding IsLanguagePickerEnabled}" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="FillAndExpand" />
                </Frame>
                <ImageButton Source="trash_red.png" WidthRequest="30" HeightRequest="30" CornerRadius="15" Command="{Binding ClearSelectedLanguageCommand}" />
            </StackLayout>

            <Button Text="Wyszukaj" Command="{Binding SearchCommand}" CornerRadius="30" WidthRequest="200" />
        </VerticalStackLayout>

        <ListView Grid.Row="1" ItemsSource="{Binding SearchResults}" Margin="10" x:Name="ResultsListView" HasUnevenRows="True" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Grid Padding="10" VerticalOptions="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackLayout Grid.Column="0" VerticalOptions="Center" HorizontalOptions="Start" Spacing="0">

                                <Label Text="{Binding CategoryName}" Grid.Column="0" VerticalOptions="Center" HorizontalOptions="Start" FontSize="Medium" />
                                <Label Text="{Binding UserName}" TextColor="Gray" FontSize="Small" />
                                
                            </StackLayout>
                            
                            <Label Text="{Binding LanguageLevel}" Grid.Column="1" VerticalOptions="Center" HorizontalOptions="Center" FontSize="Small" Margin="0,0,10,0" />

                            <Label Text="{Binding FrontLanguage}" Grid.Column="2" VerticalOptions="Center" HorizontalOptions="Center" FontSize="Small" Margin="0,0,10,0" />

                            <Label Text="{Binding BackLanguage}" Grid.Column="3" VerticalOptions="Center" HorizontalOptions="Center" FontSize="Small" Margin="0,0,10,0" />

                            <ImageButton Source="view.png" Grid.Column="4" WidthRequest="35" HeightRequest="35" Margin="3" Command="{Binding Path=BindingContext.LookFlashCardTappedCommand, Source={x:Reference Name=List}}"
                                         CommandParameter="{Binding .}" HorizontalOptions="Center" VerticalOptions="Center" />
                            
                            <ImageButton Source="add.png" Grid.Column="5" WidthRequest="35" HeightRequest="35" Margin="3" Command="{Binding Source={RelativeSource AncestorType={x:Type local:FlashCardListViewModel}}, Path=AddToLocalCommand}" 
                                         CommandParameter="{Binding .}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Grid>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        
        <Grid Grid.Row="3" VerticalOptions="End">
            <Grid.RowDefinitions>
                <RowDefinition Height="3" />
            </Grid.RowDefinitions>

            <BoxView Grid.Row="0" />
        </Grid>
    </Grid>
</ContentPage>