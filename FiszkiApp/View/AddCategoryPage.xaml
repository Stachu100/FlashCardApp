<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:FiszkiApp.View"
             xmlns:viewmodel="clr-namespace:FiszkiApp.ViewModel"
             x:Class="FiszkiApp.View.AddCategoryPage"
             x:DataType="viewmodel:AddCategoryViewModel"
             Title="Dodaj kategorię">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <Image Source="background.png" Aspect="AspectFill" Opacity="0.2" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" Grid.RowSpan="2" />

        <StackLayout Padding="20" Grid.Row="0" Margin="0,40">
            
            <Frame BackgroundColor="#33512BD4" Padding="0" HorizontalOptions="FillAndExpand" CornerRadius="30" HasShadow="False" Margin="0,10">
                <Entry x:Name="CategoryNameEntry" Placeholder="Nazwa kategorii*" PlaceholderColor="DarkViolet" MaxLength="50" Text="{Binding CategoryName}" />
            </Frame>

            <Frame BackgroundColor="#33512BD4" Padding="0" HorizontalOptions="FillAndExpand" CornerRadius="30" HasShadow="False" Margin="0,10">
                <Picker x:Name="LanguageLevelPicker" Title="Poziom językowy" TitleColor="DarkViolet" ItemsSource="{Binding LanguageLevel}" SelectedItem="{Binding SelectedLanguageLevel}" />
            </Frame>

            <Frame BackgroundColor="#33512BD4" Padding="0" HorizontalOptions="FillAndExpand" CornerRadius="30" HasShadow="False" Margin="0,10">
                <Picker x:Name="FrontLanguagePicker" Title="Język przodu fiszek*" TitleColor="DarkViolet" ItemsSource="{Binding FrontLanguages}" SelectedItem="{Binding SelectedFrontLanguage}" SelectedIndexChanged="OnSelectedFrontLanguageChanged" />
            </Frame>

            <Label Text="Najpierw wybierz język przodu fiszek" TextColor="Red" IsVisible="{Binding IsFrontLanguageEmpty}" FontAttributes="Bold" />
            <Frame BackgroundColor="#33512BD4" Padding="0" HorizontalOptions="FillAndExpand" CornerRadius="30" HasShadow="False" Margin="0,10">
                <Picker x:Name="BackLanguagePicker" Title="Język tyłu fiszek*" TitleColor="DarkViolet" ItemsSource="{Binding BackLanguages}" SelectedItem="{Binding SelectedBackLanguage}" IsEnabled="{Binding IsBackLanguageEnabled}" />
            </Frame>

            <Label Text="Pola oznaczone gwiazdką (*) są wymagane" HorizontalOptions="Center" FontAttributes="Bold,Italic" TextColor="DarkViolet" />

            <Button Text="Zatwierdź" FontAttributes="Bold" CornerRadius="30" WidthRequest="200" VerticalOptions="EndAndExpand" Margin="0,15" Command="{Binding SubmitCategoryCommand}" />

            <Label Text="Anuluj" FontAttributes="Bold" TextColor="#D600AA" FontSize="Medium" HorizontalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CancelCategoryCommand}" />
                </Label.GestureRecognizers>
            </Label>
        </StackLayout>

        <Grid Grid.Row="1" VerticalOptions="End">
            <Grid.RowDefinitions>
                <RowDefinition Height="3" />
            </Grid.RowDefinitions>

            <BoxView Grid.Row="0" Color="#D600AA" />
        </Grid>
    </Grid>
</ContentPage>
