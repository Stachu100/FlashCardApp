<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="FiszkiApp.View.LoginPage"
             xmlns:vm="clr-namespace:FiszkiApp.ViewModel"
             x:DataType="vm:LoginPageViewModel"    
             Title="LoginPage"
             Shell.FlyoutBehavior="Disabled"
             Shell.NavBarIsVisible="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <Image Source="{DynamicResource BackgroundImage}" Aspect="AspectFill" Opacity="0.2" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" Grid.RowSpan="3" />

        <Grid RowSpacing="5" Grid.Row="1" Margin="20,20,20,0" HorizontalOptions="FillAndExpand">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="50" />
                <RowDefinition Height="50" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="40" />
                <RowDefinition Height="40" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>
            <Label Grid.Row="1" Text="Witaj!" HorizontalOptions="Center" FontSize="38" FontAttributes="Bold" Padding="0" Margin="0" />
            <Label Grid.Row="2" Text="Zaloguj się" TextColor="Black" HorizontalOptions="Center" FontAttributes="Bold" FontSize="22" />

            <StackLayout Grid.Row="3" Orientation="Vertical" HorizontalOptions="FillAndExpand" Spacing="10">
                <Frame Padding="0" HorizontalOptions="FillAndExpand" CornerRadius="30">
                    <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand">
                        <Entry Text="{Binding UserName}" Placeholder="Nazwa" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="FillAndExpand" Margin="0,0,20,0" />
                    </StackLayout>
                </Frame>
                <Frame Padding="0" HorizontalOptions="FillAndExpand" CornerRadius="30">
                    <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand">
                        <Entry Text="{Binding UserPassword}" Placeholder="Hasło" IsPassword="True" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="FillAndExpand" Margin="0,0,20,0" />
                    </StackLayout>
                </Frame>
                <Label Text="{Binding ErrorMessages, Mode=OneWay}" TextColor="Red" />
                <StackLayout Orientation="Horizontal" Margin="0,10,0,0" Padding="0">
                    <CheckBox IsChecked="{Binding RememberMe}" />
                    <Label Text="Zapamiętaj mnie" FontSize="Small" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                </StackLayout>
                <Button Text="Zaloguj się" FontAttributes="Bold" CornerRadius="30" WidthRequest="200" Margin="0,60,0,0" Command="{Binding LoginCommandCommand}" />

                <StackLayout Orientation="Horizontal" HorizontalOptions="CenterAndExpand" Margin="0,40,0,0" Padding="0">
                    <Label Text="Jesteś nowy? " FontSize="Small" />
                    <Label Text="Zarejestruj się" TextColor="Black" FontAttributes="Bold" FontSize="Small">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="OnLabelTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </StackLayout>
            </StackLayout>
        </Grid>

        <Grid Grid.Row="2" VerticalOptions="End">
            <Grid.RowDefinitions>
                <RowDefinition Height="3" />
                <RowDefinition Height="45" />
            </Grid.RowDefinitions>

            <BoxView Grid.Row="0" />
            <BoxView Grid.Row="1" Color="{DynamicResource BoxViewBottomColor}" />

            <Grid Grid.Row="1" Padding="10,0" ColumnSpacing="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" Text="CodeBros (c) &#10;Wszelkie prawa zastrzeżone" FontSize="Small" VerticalOptions="Center" HorizontalOptions="Start" />
                <Label Grid.Column="1" Text="Wersja aplikacji: 1.01" FontSize="Small" VerticalOptions="Center" HorizontalOptions="End" />
            </Grid>
        </Grid>

    </Grid>
</ContentPage>