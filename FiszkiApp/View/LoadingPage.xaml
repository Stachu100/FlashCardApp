<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FiszkiApp.View.LoadingPage"
             Title="LoadingPage"
             Shell.FlyoutBehavior="Disabled"
             Shell.NavBarIsVisible="False">

    <Grid>
        <Image Source="{DynamicResource BackgroundImage}" Aspect="AspectFill" Opacity="0.2" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" />

        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
            
            <ActivityIndicator IsRunning="True" />
            
            <Label Text="Sprawdzanie poprawności danych" HorizontalTextAlignment="Center" TextColor="Black" FontSize="18" />
            
        </VerticalStackLayout>

    </Grid>
</ContentPage>