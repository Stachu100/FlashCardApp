<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FiszkiApp.ViewModel"
             x:DataType="vm:RegisterViewModel"
             x:Class="FiszkiApp.View.RegisterPage"
             xmlns:toolkit="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
             Shell.FlyoutBehavior="Disabled"
             Shell.NavBarIsVisible="False">
    <ContentPage.BindingContext>
        <vm:RegisterViewModel />
    </ContentPage.BindingContext>

    <Grid BackgroundColor="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <Image Source="background.png" Aspect="AspectFill" Opacity="0.2" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" Grid.RowSpan="2"/>

        <ScrollView Grid.Row="0">
            <Grid RowSpacing="5" Margin="20,20,20,0" HorizontalOptions="FillAndExpand">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Text="Rejestracja" TextColor="DarkViolet" HorizontalOptions="Center" FontSize="38" FontAttributes="Bold" Padding="0" Margin="0"/>

                <StackLayout Grid.Row="1" Orientation="Vertical" HorizontalOptions="FillAndExpand" Spacing="10">

                    <Frame HeightRequest="100" WidthRequest="100" CornerRadius="50" Padding="0" Margin="0"
                           BackgroundColor="#33512BD4" HorizontalOptions="Center" HasShadow="False">

                        <Image Aspect="AspectFill">
                            <Image.Source>
                                <Binding Path="ImageAsByte" Converter="{toolkit:ByteArrayToImageSourceConverter}" TargetNullValue="avataricon2.png" />
                            </Image.Source>
                        </Image>

                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AvatarCommand}" />
                        </Frame.GestureRecognizers>
                    </Frame>

                    <Frame BackgroundColor="#22512BD4" Padding="0" HorizontalOptions="FillAndExpand" CornerRadius="30">
                        <Entry Text="{Binding User.Name}" Placeholder="Nazwa" PlaceholderColor="DarkViolet" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="FillAndExpand" Margin="0,0,20,0"/>
                    </Frame>

                    <Frame BackgroundColor="#22512BD4" Padding="0" HorizontalOptions="FillAndExpand" CornerRadius="30">
                        <Entry Text="{Binding User.FirstName}" Placeholder="Imię" PlaceholderColor="DarkViolet" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="FillAndExpand" Margin="0,0,20,0"/>
                    </Frame>

                    <Frame BackgroundColor="#22512BD4" Padding="0" HorizontalOptions="FillAndExpand" CornerRadius="30">
                        <Entry Text="{Binding User.LastName}" Placeholder="Nazwisko" PlaceholderColor="DarkViolet" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="FillAndExpand" Margin="0,0,20,0"/>
                    </Frame>

                    <Frame BackgroundColor="#22512BD4" Padding="0" HorizontalOptions="FillAndExpand" CornerRadius="30">
                        <Picker ItemsSource="{Binding CountryPicker}" Title="Wybierz kraj" TitleColor="DarkViolet" FontAttributes="Bold" SelectedItem="{Binding User.Country}" HorizontalOptions="FillAndExpand"/>
                    </Frame>

                    <Frame BackgroundColor="#22512BD4" Padding="0" HorizontalOptions="FillAndExpand" CornerRadius="30">
                        <Entry Text="{Binding User.Password}" Placeholder="Hasło" PlaceholderColor="DarkViolet" IsPassword="True" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="FillAndExpand" Margin="0,0,20,0"/>
                    </Frame>

                    <Frame BackgroundColor="#22512BD4" Padding="0" HorizontalOptions="FillAndExpand" CornerRadius="30">
                        <Entry Text="{Binding User.RepeatPassword}" Placeholder="Powtórz hasło" PlaceholderColor="DarkViolet" IsPassword="True" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="FillAndExpand" Margin="0,0,20,0"/>
                    </Frame>

                    <Frame BackgroundColor="#22512BD4" Padding="0" HorizontalOptions="FillAndExpand" CornerRadius="30">
                        <Entry Text="{Binding User.Email, Mode=TwoWay}"  Placeholder="Email" PlaceholderColor="DarkViolet" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="FillAndExpand" Margin="0,0,20,0"/>
                    </Frame>

                    <StackLayout Orientation="Horizontal" Margin="0,10,0,0" Padding="0">
                        <CheckBox IsChecked="{Binding User.IsAcceptedPolicy}" />
                        <Label Text="Oświadczam że, akceptuję " TextColor="DarkViolet" FontAttributes="Bold" FontSize="Micro" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        <Label Text="politykę prywatności i regulamin" TextColor="Black" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" FontSize="Micro">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPrivacyPolicyTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </StackLayout>

                    <Label Text="{Binding ErrorMessages, Mode=OneWay}" TextColor="Red" />

                    <Button Text="Zarejestruj się" FontAttributes="Bold" CornerRadius="30" WidthRequest="200" Margin="0,10,0,0" Command="{Binding RegisterCommand}"/>
                </StackLayout>
            </Grid>
        </ScrollView>

        <Grid Grid.Row="1" VerticalOptions="End">
            <Grid.RowDefinitions>
                <RowDefinition Height="3"/>
                <RowDefinition Height="45"/>
            </Grid.RowDefinitions>

            <BoxView Grid.Row="0" Color="#D600AA" />
            <BoxView Grid.Row="1" Color="#ac99ea"/>

            <Grid Grid.Row="1" Padding="10,0" ColumnSpacing="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" Text="CodeBros (c) &#10;Wszelkie prawa zastrzeżone" TextColor="#D600AA" VerticalOptions="Center" HorizontalOptions="Start"/>
                <Label Grid.Column="1" Text="Wersja aplikacji: 1.01" TextColor="#D600AA" VerticalOptions="Center" HorizontalOptions="End"/>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
