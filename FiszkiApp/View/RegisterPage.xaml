<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FiszkiApp.ViewModel"
             x:DataType="vm:RegisterViewModel"
             x:Class="FiszkiApp.View.RegisterPage"
             xmlns:toolkit="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
             xmlns:converters="clr-namespace:FiszkiApp.EntityClasses"
             Shell.FlyoutBehavior="Disabled"
             Shell.NavBarIsVisible="False">
    
    <ContentPage.BindingContext>
        <vm:RegisterViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:ByteArrayToImageSourceConverter x:Key="AvatarWithFallback" UseFallback="True"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <Image Source="{DynamicResource BackgroundImage}" Aspect="AspectFill" Opacity="0.2" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" Grid.RowSpan="2" />

        <ScrollView Grid.Row="0">
            <Grid RowSpacing="5" Margin="20,20,20,0" HorizontalOptions="FillAndExpand">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Text="Rejestracja" HorizontalOptions="Center" FontSize="38" FontAttributes="Bold" Padding="0" Margin="0" />

                <StackLayout Grid.Row="1" Orientation="Vertical" HorizontalOptions="FillAndExpand" Spacing="10">

                    <Frame HeightRequest="100" WidthRequest="100" CornerRadius="50" Padding="0" Margin="0" HorizontalOptions="Center" HasShadow="False">

                        <Image Aspect="AspectFill">
                            <Image.Source>
                                <Binding Path="ImageAsByte" Converter="{StaticResource AvatarWithFallback}" />
                            </Image.Source>
                        </Image>

                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AvatarCommand}" />
                        </Frame.GestureRecognizers>
                    </Frame>

                    <Frame Padding="0" HorizontalOptions="FillAndExpand" CornerRadius="30">
                        <Entry Text="{Binding User.Name}" Placeholder="Nazwa" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="FillAndExpand" Margin="0,0,20,0" />
                    </Frame>

                    <Frame Padding="0" HorizontalOptions="FillAndExpand" CornerRadius="30">
                        <Entry Text="{Binding User.FirstName}" Placeholder="Imię" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="FillAndExpand" Margin="0,0,20,0" />
                    </Frame>

                    <Frame Padding="0" HorizontalOptions="FillAndExpand" CornerRadius="30">
                        <Entry Text="{Binding User.LastName}" Placeholder="Nazwisko" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="FillAndExpand" Margin="0,0,20,0" />
                    </Frame>

                    <Frame Padding="0" HorizontalOptions="FillAndExpand" CornerRadius="30">
                        <Picker ItemsSource="{Binding CountryPicker}" Title="Wybierz kraj" FontAttributes="Bold" SelectedItem="{Binding User.Country}" HorizontalOptions="FillAndExpand" />
                    </Frame>

                    <Frame Padding="0" HorizontalOptions="FillAndExpand" CornerRadius="30">
                        <Entry Text="{Binding User.Password}" Placeholder="Hasło" IsPassword="True" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="FillAndExpand" Margin="0,0,20,0" />
                    </Frame>

                    <Frame Padding="0" HorizontalOptions="FillAndExpand" CornerRadius="30">
                        <Entry Text="{Binding User.RepeatPassword}" Placeholder="Powtórz hasło" IsPassword="True" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="FillAndExpand" Margin="0,0,20,0" />
                    </Frame>

                    <Frame Padding="0" HorizontalOptions="FillAndExpand" CornerRadius="30">
                        <Entry Text="{Binding User.Email, Mode=TwoWay}"  Placeholder="Email" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="FillAndExpand" Margin="0,0,20,0" />
                    </Frame>

                    <StackLayout Orientation="Horizontal" Margin="0,10,0,0" Padding="0">
                        <CheckBox IsChecked="{Binding User.IsAcceptedPolicy}" />
                        <Label Text="Oświadczam że, akceptuję " FontAttributes="Bold" FontSize="Micro" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        <Label Text="politykę prywatności i regulamin" TextColor="Black" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" FontSize="Micro">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPrivacyPolicyTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </StackLayout>

                    <Label Text="{Binding ErrorMessages, Mode=OneWay}" TextColor="Red" />

                    <Button Text="Zarejestruj się" FontAttributes="Bold" CornerRadius="30" WidthRequest="200" Margin="0,10,0,0" Command="{Binding RegisterCommand}" />
                </StackLayout>
            </Grid>
        </ScrollView>

        <Grid Grid.Row="1" VerticalOptions="End">
            <Grid.RowDefinitions>
                <RowDefinition Height="3" />
                <RowDefinition Height="45" />
            </Grid.RowDefinitions>

            <BoxView Grid.Row="0" />
            <BoxView Grid.Row="1" Color="{DynamicResource BoxViewBottomColor}" />

            <Grid Grid.Row="1" Padding="10,0" ColumnSpacing="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" Text="CodeBros (c) &#10;Wszelkie prawa zastrzeżone" VerticalOptions="Center" HorizontalOptions="Start" />
                <Label Grid.Column="1" Text="Wersja aplikacji: 1.01" VerticalOptions="Center" HorizontalOptions="End" />
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
