<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FiszkiApp.View.PasswordChangePage"
             xmlns:vm="clr-namespace:FiszkiApp.ViewModel"
             x:DataType="vm:ChangePasswordViewModel"
             xmlns:toolkit="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
             xmlns:converters="clr-namespace:FiszkiApp.EntityClasses"
             Title="Zmiana hasła">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <Image Source="{DynamicResource BackgroundImage}" Aspect="AspectFill" Opacity="0.2" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" Grid.RowSpan="2" />

        <StackLayout Grid.Row="0" VerticalOptions="Center" HorizontalOptions="FillAndExpand" Padding="10" Spacing="10">
            <Frame HeightRequest="250" WidthRequest="250" CornerRadius="125" Padding="0" HasShadow="False" HorizontalOptions="Center">
                <Image Source="gnome_password.png" Aspect="AspectFill"/>
            </Frame>
            <Frame Padding="0" HorizontalOptions="FillAndExpand" CornerRadius="30">
                <Entry Text="{Binding ChangePassowrd.OldPassword}" Placeholder="Stare hasło" IsPassword="True" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="FillAndExpand" Margin="0,0,20,0" />
            </Frame>

            <BoxView HeightRequest="1" Color="Gray" Margin="0,5"/>

            <Frame Padding="0" HorizontalOptions="FillAndExpand" CornerRadius="30">
                <Entry Text="{Binding ChangePassowrd.NewPassword}" Placeholder="Hasło" IsPassword="True" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="FillAndExpand" Margin="0,0,20,0" />
            </Frame>

            <Frame Padding="0" HorizontalOptions="FillAndExpand" CornerRadius="30">
                <Entry Text="{Binding ChangePassowrd.RepeatNewPassword}" Placeholder="Powtórz hasło" IsPassword="True" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="FillAndExpand" Margin="0,0,20,0" />
            </Frame>

            <Label Text="{Binding ErrorMessages, Mode=OneWay}" TextColor="Red" />

            <Button Text="Zmień" FontAttributes="Bold" CornerRadius="30" WidthRequest="200" Margin="0,10,0,0" Command="{Binding ChangePasswordCommand}" />
        </StackLayout>

        <Grid Grid.Row="1" VerticalOptions="End">
            <Grid.RowDefinitions>
                <RowDefinition Height="3" />
            </Grid.RowDefinitions>

            <BoxView Grid.Row="0" />
        </Grid>

    </Grid>
</ContentPage>