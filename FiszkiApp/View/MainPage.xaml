<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FiszkiApp.View.MainPage"
             xmlns:toolkit="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
             xmlns:vm="clr-namespace:FiszkiApp.ViewModel"
             xmlns:converters="clr-namespace:FiszkiApp.EntityClasses"
             x:Name="MainPageContent">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:IsSentToVisibilityConverter x:Key="IsSentToVisibilityConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <Image Source="background.png"
               Aspect="AspectFill"
               Opacity="0.2"
               VerticalOptions="FillAndExpand"
               HorizontalOptions="FillAndExpand"
               Grid.RowSpan="3"/>

        <Button Text="Dodaj kategorię" FontAttributes="Bold" CornerRadius="30" WidthRequest="200" Margin="0,15,0,10" Grid.Row="0" Command="{Binding AddCategoryCommand}" />

        <CollectionView Grid.Row="1" ItemsSource="{Binding Categories}" SelectionMode="Single"
                        SelectionChangedCommand="{Binding CategoryTappedCommand}"
                        SelectionChangedCommandParameter="{Binding CurrentSelection[0], Source={x:Reference Name=CategoriesCollection}}">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="10" Margin="5" CornerRadius="12" HasShadow="True" BackgroundColor="#f0f4ff">
                        <Grid VerticalOptions="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Path=BindingContext.CategoryTappedCommand, Source={x:Reference Name=MainPageContent}}"
                                              CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>

                            <Label Text="{Binding CategoryName}" Grid.Column="0" VerticalOptions="Center" FontSize="18" FontAttributes="Bold" TextColor="#333" />

                            <Image Source="{Binding FrontFlagUrl}" Grid.Column="1" WidthRequest="40" HeightRequest="25" Margin="5"/>
                            <Image Source="{Binding BackFlagUrl}" Grid.Column="2" WidthRequest="40" HeightRequest="25" Margin="5"/>

                            <ImageButton Source="add.png" Grid.Column="3" WidthRequest="30" HeightRequest="30" Margin="3"
                                 BackgroundColor="Transparent"
                                 Command="{Binding Path=BindingContext.ViewFlashcardsCommand, Source={x:Reference Name=MainPageContent}}"
                                 CommandParameter="{Binding .}" />

                            <ImageButton Source="remove.png" Grid.Column="4" WidthRequest="30" HeightRequest="30" Margin="3"
                                 BackgroundColor="Transparent"
                                 Command="{Binding Path=BindingContext.DeleteCategoryCommand, Source={x:Reference Name=MainPageContent}}"
                                 CommandParameter="{Binding .}" />

                            <ImageButton Source="cloud.png" Grid.Column="5" WidthRequest="30" HeightRequest="30" Margin="3"
                                 BackgroundColor="Transparent"
                                 IsVisible="{Binding IsSent, Converter={StaticResource IsSentToVisibilityConverter}}"
                                 Command="{Binding Path=BindingContext.SendCategoryCommand, Source={x:Reference Name=MainPageContent}}"
                                 CommandParameter="{Binding .}" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.Row="2" VerticalOptions="End">
            <Grid.RowDefinitions>
                <RowDefinition Height="5" />
            </Grid.RowDefinitions>

            <BoxView Grid.Row="0" Color="Red" />
        </Grid>
    </Grid>
</ContentPage>